[Unit]
Description=Gemini GWS API service for VSCADA
After=network.target

[Service]
Environment="PATH=/home/software/setup/miniconda3/envs/gws-api/bin:$PATH"
WorkingDirectory=/usr/bin
ExecStart=/home/software/setup/miniconda3/envs/gws-api/bin/gunicorn -b 127.0.0.1:8888 -w 4 gemgwsapi:app
Type=simple
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
